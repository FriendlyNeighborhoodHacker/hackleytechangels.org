---
import Angels from '../components/Angels.astro';
import Backdrop from '../components/Backdrop.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Home from '../components/Home.astro';
import LogoDefs from '../components/LogoDefs.astro';
import Nav from '../components/Nav.astro';
import Portfolio from '../components/Portfolio.astro';
import Story from '../components/Story.astro';
import Thanks from '../components/Thanks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// The whole site is this one page. Each "page" is a full-screen view
// (#home, #portfolio, #angels, #story, #contact, plus #thanks after the form is sent) and src/scripts/site.ts
// switches between them on the URL hash, so the sky and doves carry across.
---

<BaseLayout>
  <LogoDefs />
  <Backdrop />
  <Nav />

  <Home />
  <Portfolio />
  <Angels />
  <Story />
  <Contact />
  <Thanks />

  <Footer />
</BaseLayout>

<script>
  // Order matters: site.ts sets body[data-route], which the others read.
  import '../scripts/site.ts';
  import '../scripts/contact.ts';
  import '../scripts/glass.ts';
  import '../scripts/nixie.ts';
</script>
