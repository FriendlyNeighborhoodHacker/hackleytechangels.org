---
import { Image } from 'astro:assets';
import { caseStudies, personalProjects } from '../data/portfolio';
import Arrow from './Arrow.astro';
import BrowserWindow from './BrowserWindow.astro';
import PageHead from './PageHead.astro';
import Terminal from './Terminal.astro';

// Entrance stagger: heading 1-3, then each block in reading order.
const caseI = 4;
const headI = caseI + caseStudies.length;
const projI = headI + 1;
---

<section id="portfolio" class="view sub" aria-labelledby="p-title">
  <PageHead id="p-title" top="OUR" bottom="PORTFOLIO">
    Ideas brought to life by Hackley students &mdash;<br class="br"> from first concept to real-world impact.
    <div slot="after" class="filters st glass" style="--i:3" role="group" aria-label="Jump to section">
      <span class="pill" aria-hidden="true"></span>
      <button type="button" data-t="pf-client" aria-pressed="true"><span class="lbl">Official work</span><span class="n">{caseStudies.length}</span></button>
      <button type="button" data-t="pf-personal" aria-pressed="false"><span class="lbl">Personal projects</span><span class="n">{personalProjects.length}</span></button>
    </div>
  </PageHead>

  <div class="pf" id="pf-client">
    {caseStudies.map((c, n) => (
      <article class="case st" id={`case-${c.id}`} style={`--i:${caseI + n}`}>
        <div class="case-media">
          {c.media.kind === 'phones' && (
            <div class="phones">
              {c.media.shots.map((shot, k) => (
                <figure class={`phone p${k + 1}`}><Image src={shot.src} alt={shot.alt} /></figure>
              ))}
            </div>
          )}
          {c.media.kind === 'windows' && (
            <div class="wins">
              <BrowserWindow shot={c.media.windows[0]} class="w1" />
              <BrowserWindow shot={c.media.windows[1]} class="w2" />
            </div>
          )}
          {c.media.kind === 'windows' && c.media.thumbs && (
            <div class="thumbs">
              {c.media.thumbs.map((shot) => <BrowserWindow shot={shot} class="t" />)}
            </div>
          )}
        </div>
        <div class="case-text">
          <span class="kicker">{c.kicker}</span>
          <h3>{c.title}</h3>
          <span class="by">Built by {c.by}</span>
          <p class="case-lead">{c.lead}</p>
          <ul class="facts">{c.facts.map((f) => <li><b>{f.label}</b><span>{f.text}</span></li>)}</ul>
          <ul class="skills">{c.skills.map((s) => <li>{s}</li>)}</ul>
          <div class="case-foot"><a class="cta glass" href={c.link.href} target="_blank" rel="noopener"><span>{c.link.label}</span><Arrow /></a><small>{c.note}</small></div>
        </div>
      </article>
    ))}
  </div>

  <div class="pf-personal" id="pf-personal">
    <header class="sec-head st" style={`--i:${headI}`}>
      <h3>Personal projects</h3>
      <p>What our members build on their own time.</p>
    </header>
    <div class="projs">
      {personalProjects.map((p, n) => (
        <article class={`proj ${p.size} st`} style={`--i:${projI + n}`}>
          <div class="proj-media">
            {p.media.kind === 'shot' && <figure class="shot"><Image src={p.media.shot.src} alt={p.media.shot.alt} /></figure>}
            {p.media.kind === 'window' && <BrowserWindow shot={p.media.shot} />}
            {p.media.kind === 'terminal' && <Terminal title={p.media.title} html={p.media.html} />}
          </div>
          <div class="proj-body">
            <span class="kicker">{p.kicker}</span>
            <h4>{p.title}</h4>
            <span class="by">Built by {p.by}</span>
            <p>{p.blurb}</p>
            <ul class="skills">{p.skills.map((s) => <li>{s}</li>)}</ul>
            <a class="more" href={p.link.href} target="_blank" rel="noopener">{p.link.label} <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
