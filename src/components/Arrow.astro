---
// The round arrow badge on buttons: two copies of the arrow so one slides out
// as the other slides in on hover (see `.arr` in global.css).
const d = 'M2.75 8h10.2M8.9 3.9 13 8l-4.1 4.1';
---

<span class="arr" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={d}/></svg><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={d}/></svg></span>
